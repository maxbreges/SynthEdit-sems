<?xml version="1.0" encoding="UTF-8"?>
<PluginList>
    <Plugin id="My FloatAnimation" name="Float Animation" category="mx/Sub-Controls">
		<Audio>
			<Pin name="Bool" datatype="bool" direction="out" />
			<Pin name="Int" datatype="int" direction="out" private="true"/>
		</Audio>
		<GUI>
            <Pin name="On/Off" datatype="bool"/>
			<Pin name="Speed" datatype="float" default="0.5"/>
            <Pin name="Animation Position" datatype="float" direction="out"/>
        </GUI>
    </Plugin>
</PluginList>
