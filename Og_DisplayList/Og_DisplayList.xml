<?xml version="1.0" encoding="UTF-8"?>
<PluginList>
    <Plugin id="My Og_DisplayList" name="Display List" category="Og/Sub-Controls">
        <GUI graphicsApi="GmpiGui">
            <Pin name="BgColor" datatype="string" default="FF000000" private="true"/>
            <Pin name="Color" datatype="string" default="FF666666"/>
            <Pin name="Text Color" datatype="string" default="ffffffff"/>
            <Pin name="Text Font" datatype="string" default="Times New Roman" isMinimised="true"/>
            <Pin name="Font Size" datatype="float" default="16" isMinimised="true"/>
            <Pin name="Choice" datatype="int"/>
            <Pin name="Item List" datatype="string"/>
			<Pin name="Selection" datatype="string" />
            <Pin name="PopUp open" datatype="bool" direction="out"/>
            <Pin name="Corner Radius" datatype="float" default="5" isMinimised="true"/>
			<Pin name="Corner On/Off" datatype="bool" default="1" isMinimised="true"/>
			<Pin name="!previousFolder" datatype="bool" />
			<Pin name="Update Display" datatype="bool" />
        </GUI>
    </Plugin>
</PluginList>
