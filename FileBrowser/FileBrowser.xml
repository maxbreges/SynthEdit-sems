<?xml version="1.0" encoding="UTF-8"?>
<PluginList>
    <Plugin id="My FileBrowser" name="File Browser" category="mx/Sub-Controls" >
        <GUI>
            <Pin name="Path" datatype="string"/>
            <Pin name="Allowed Extensions" datatype="string" default="wav" isMinimised="false"/>
            <Pin name="Hide Extensions" datatype="bool" default="1" isMinimised="true"/>
            <Pin name="Choice" datatype="int" direction="out"/>
            <Pin name="Item List" datatype="string" direction="out"/>
        </GUI>
    </Plugin>
</PluginList>
